<link rel="stylesheet" href="${URLUtils.staticURL('/css/customerForm.css')}" />


<form action="${formAction}" method="post">
    <fieldset>
        <legend>${Resource.msg('customer.form.shippinginfo', 'customerform', null)}</legend>

        <label for="firstName">${Resource.msg('customer.form.firstname', 'customerform', null)}:</label>
        <input type="text" name="firstName" required>

        <label for="lastName">${Resource.msg('customer.form.lastname', 'customerform', null)}:</label>
        <input type="text" name="lastName" required>

        <label for="address1">${Resource.msg('customer.form.address1', 'customerform', null)}:</label>
        <input type="text" name="address1" required>

        <label for="address2">${Resource.msg('customer.form.address2', 'customerform', null)}:</label>
        <input type="text" name="address2">

        <label for="country">${Resource.msg('customer.form.country', 'customerform', null)}:</label>
        <select name="country">
            <option>USA</option>
            <option>Canada</option>
            <option>UK</option>
            <option>Bulgaria</option>

        </select>

        <label for="state">${Resource.msg('customer.form.state', 'customerform', null)}:</label>
        <input type="text" name="state" required>

        <label for="postalCode">${Resource.msg('customer.form.postalCode', 'customerform', null)}:</label>
        <input type="text" name="postalCode" required>

        <label for="phoneNumber">${Resource.msg('customer.form.phoneNumber', 'customerform', null)}:</label>
        <input type="text" name="phoneNumber" required>
    </fieldset>

    <fieldset>
        <legend>${Resource.msg('customer.form.paymentinfo', 'customerform', null)}</legend>

        <label for="cardNumber">${Resource.msg('customer.form.cardNumber', 'customerform', null)}:</label>
        <input type="text" name="cardNumber" required>

        <label for="expMonth">${Resource.msg('customer.form.expMonth', 'customerform', null)}:</label>
        <select name="expMonth">
            <option>01</option>
            <option>02</option>
            <option>03</option>
            <option>04</option>
            <option>05</option>
            <option>06</option>
            <option>07</option>
            <option>08</option>
            <option>09</option>
            <option>10</option>
            <option>11</option>
            <option>12</option>
        </select>

        <label for="expYear">${Resource.msg('customer.form.expYear', 'customerform', null)}:</label>
        <select name="expYear">
            <option>2025</option>
            <option>2026</option>
            <option>2027</option>
        </select>

        <label for="securityCode">${Resource.msg('customer.form.securityCode', 'customerform', null)}:</label>
        <input type="text" name="securityCode" required>

        <label for="email">${Resource.msg('customer.form.email', 'customerform', null)}:</label>
        <input type="email" name="email" required>
    </fieldset>

    <label for="comments">Comments:</label>
    <textarea id="comments" name="comments" rows="3" maxlength="150"></textarea>
    <p id="charCount" data-template="You have {0} characters left out of 150">
        You have 150 characters left out of 150
    </p>

    <button type="submit">${Resource.msg('customer.form.submit', 'customerform', null)}</button>
</form>

<button id="scrollToTop">${Resource.msg('customer.form.scrollToTop', 'customerform', null)}</button>

<!-- JavaScript for Character Count & Scroll -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var commentsInput = document.getElementById("comments");
        var charCount = document.getElementById("charCount");
        var scrollToTopBtn = document.getElementById("scrollToTop");

        // Character Count Functionality
        if (commentsInput && charCount) {
            commentsInput.addEventListener("input", function () {
                var remaining = 150 - this.value.length;
                var message = charCount.dataset.template.replace("{0}", remaining);
                charCount.textContent = message;
            });
        }

        // Scroll to Top Functionality
        if (scrollToTopBtn) {
            scrollToTopBtn.addEventListener("click", function () {
                window.scrollTo({ top: 0, behavior: "smooth" });
            });
        }
    });
</script>