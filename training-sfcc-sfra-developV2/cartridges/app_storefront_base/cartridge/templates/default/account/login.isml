<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/login.css');
        assets.addJs('/js/login.js');
        
    </isscript>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
    $(document).ready(function () {
        $(".image-switcher img").click(function () {
            // Remove selection from all images
            $(".image-switcher img").removeClass("selected");

            // Add selection to clicked image
            $(this).addClass("selected");

            // Check which image was clicked
            if ($(this).hasClass("img1")) {
                $(".first-card").show();
                $(".second-card").hide();
            } else if ($(this).hasClass("img2")) {
                $(".first-card").hide();
                $(".second-card").show();
            }
        });

        // Ensure a default card is shown when the page loads
        $(".img1").addClass("selected"); // Set img1 as default selected
        $(".first-card").show();
    });
</script>



    <style>
        .image-switcher {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            width: 100%;
            padding: 20px 0;
        }

        /* Default state: both images are desaturated */
        .image-switcher img {
            width: 300px;
            height: 300px;
            object-fit: cover;
            filter: grayscale(100%);
            transition: filter 0.3s ease-in-out, transform 0.2s ease-in-out;
            cursor: pointer;
            border-radius: 10px;
        }

        /* When an image is selected (colored) */
        .image-switcher img.selected {
            filter: grayscale(0%);
            transform: scale(1.1);
        }

        /* Hide both cards initially */
        .card {
            display: none;
        }

        /* Show first card when img1 is selected */
        .card.first-card {
            display: block;
        }

        /* Show second card when img2 is selected */
        .card.second-card {
            display: block;
        }
    </style>

    <div class="hero slant-down login-banner">
        <h1 class="page-title">${Resource.msg('header.hero.image.login', 'login', null)}</h1>
        <h1 class="page-title">${Resource.msg('header.hero.image.login', 'login', null)}</h1>

    </div>

    <div class="image-switcher">
        <isslot id="images" description="" context="global" />
    </div>

    <div class="container login-page">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
        <div class="row justify-content-center equal-height">
            <div class="col-sm-8 col-md-6">
                <div class="card first-card">
                    <!-- First Card -->
                    <div class="card-body">
                        <div class="login-form-nav">
                            <isinclude template="account/components/navTabs" />
                            <div class="tab-content">
                                <div class="tab-pane ${pdict.navTabValue === 'login' ? 'active' : ''}" id="login"
                                    role="tabpanel" aria-labelledby="login-tab">
                                    <isinclude template="account/components/loginForm" />
                                    <isinclude template="account/password/requestPasswordResetModal" />
                                    <isinclude template="account/components/oauth" />
                                </div>
                                <div class="tab-pane ${pdict.navTabValue === " register" ? 'active' : ''}"
                                    id="register" role="tabpanel" aria-labelledby="register-tab">
                                    <isinclude template="account/components/registerForm" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-8 col-md-6">
                <div class="card second-card">
                    <!-- Second Card -->
                    <isinclude template="account/components/trackOrderForm" />
                </div>
            </div>
        </div>

    </div>
</isdecorate>