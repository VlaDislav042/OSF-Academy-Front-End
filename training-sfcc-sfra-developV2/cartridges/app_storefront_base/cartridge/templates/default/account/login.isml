<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/login.css');
        assets.addJs('/js/login.js');
        
    </isscript>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
    console.log("✅ jQuery is loaded!");

    // Set default selection (First image and first card)
    $(".img1").addClass("selected");
    $(".first-card").addClass("active").show();
    $(".second-card").removeClass("active").hide();

    $(".image-switcher .hover-image").on("click", function () {
        console.log("Image Clicked:", $(this).attr("class"));

        // Remove "selected" from all images, then add to clicked one
        $(".image-switcher .hover-image").removeClass("selected");
        $(this).addClass("selected");

        // Show the correct card
        if ($(this).hasClass("img1")) {
            $(".first-card").addClass("active").show();
            $(".second-card").removeClass("active").hide();
        } else if ($(this).hasClass("img2")) {
            $(".first-card").removeClass("active").hide();
            $(".second-card").addClass("active").show();
        }
    });
});

    </script>
    <style>

    </style>

    <div class="hero slant-down login-banner">
        <h1 class="page-title">${Resource.msg('header.hero.image.login', 'login', null)}</h1>
        <h1 class="page-title">${Resource.msg('header.hero.image.login', 'login', null)}</h1>

    </div>

    <div class="image-switcher">
        <isslot id="images" description="" context="global" />
    </div>

    <div class="container login-page">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
        <div class="row justify-content-center equal-height">
            <div class="col-sm-8 col-md-6">
                <div class="card first-card">
                    <!-- First Card -->
                    <div class="card-body">
                        <div class="login-form-nav">
                            <isinclude template="account/components/navTabs" />
                            <div class="tab-content">
                                <div class="tab-pane ${pdict.navTabValue === 'login' ? 'active' : ''}" id="login"
                                    role="tabpanel" aria-labelledby="login-tab">
                                    <isinclude template="account/components/loginForm" />
                                    <isinclude template="account/password/requestPasswordResetModal" />
                                    <isinclude template="account/components/oauth" />
                                </div>
                                <div class="tab-pane ${pdict.navTabValue === " register" ? 'active' : ''}"
                                    id="register" role="tabpanel" aria-labelledby="register-tab">
                                    <isinclude template="account/components/registerForm" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-8 col-md-6">
                <div class="card second-card">
                    <div class="card-body">
                        <!-- Second Card -->
                        <isinclude template="account/components/trackOrderForm" />
                    </div>

                </div>
            </div>
        </div>
    </div>
</isdecorate>